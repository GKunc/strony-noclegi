{
  "permissions": {
    "allow": [
      "Bash(node tools/check.mjs:*)",
      "Bash(node tools/build.mjs:*)",
      "Bash(node tools/verify.mjs:*)",
      "Bash(node tools/doctor.mjs:*)",
      "Bash(node tools/selftest.mjs:*)",
      "Bash(node tools/secrets.mjs:*)",
      "Bash(node tools/form-worker.mjs version)",
      "Bash(node tools/template-update.mjs --check:*)",
      "Bash(node tools/fleet.mjs status:*)",
      "Bash(node tools/monitor.mjs:*)",
      "Bash(node tools/history.mjs)",
      "Bash(node tools/form-worker.mjs name)",
      "Bash(node tools/form-worker.mjs bundle)",
      "Bash(node tools/test-worker.mjs)",
      "Bash(node tools/google.mjs check:*)",
      "Bash(node tools/form-test.mjs)",
      "Bash(node tools/make-assets.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh auth status:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh repo view:*)",
      "Bash(curl -sI:*)",
      "Bash(curl -s -o /dev/null:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node tools/doctor.mjs --quiet || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node tools/hook.mjs pre-bash",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node tools/hook.mjs post-edit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node tools/hook.mjs stop",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "taste-skill@taste-skill": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  }
}
